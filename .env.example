APP_NAME="Eyewear ERP"
# Production: APP_ENV=production and APP_DEBUG=false (never expose stack traces).
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Riyadh

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# One centralized MySQL/MariaDB database for all branches (Hostinger: hPanel > Databases).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Shared hosting has no persistent workers: run jobs inline.
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="erp@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- ERP ---
ERP_CURRENCY=SAR
ERP_CURRENCY_DECIMALS=2
ERP_CURRENCY_SYMBOL="ر.س"
ERP_BARCODE_PREFIX=29
# Comma-separated proxy IPs, or * when behind Hostinger's CDN/proxy. Leave empty otherwise.
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"

# Optional AI analytics (Phase 4). Off by default; only aggregated, branch-authorized figures are sent.
ERP_AI_ENABLED=false
ANTHROPIC_API_KEY=
ERP_AI_MODEL=claude-opus-5-5

# Spreadsheet imports (Phase 5): extra hosts allowed for remote files/images (comma separated, "*.domain" allowed)
ERP_IMPORT_ALLOWED_HOSTS=
# Absolute path (outside public_html) to a Google service-account JSON key, for private Google Sheets. Optional.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Public website (product showcase). Set WEBSITE_DOMAIN (e.g. alnouroptical.com) to serve it at that
# domain's root; otherwise it is served at /shop on the ERP domain.
WEBSITE_DOMAIN=
WEBSITE_PREFIX=shop
